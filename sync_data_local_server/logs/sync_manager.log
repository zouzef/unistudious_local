        <script>
        document.addEventListener('DOMContentLoaded', function () {

            function unlockAll() {
                document.querySelectorAll('.js-single-click').forEach(btn => {
                    btn.dataset.locked = "0";
                    btn.classList.remove('disabled');
                    btn.style.pointerEvents = '';

                    if (btn.tagName === 'BUTTON' || btn.tagName === 'INPUT') {
                        btn.disabled = false;
                    }
                });
            }

            document.addEventListener('click', function (e) {

                const btn = e.target.closest('.js-single-click');
                if (!btn) return;

                if (btn.dataset.locked === "1") {
                    e.preventDefault();
                    return;
                }

                btn.dataset.locked = "1";
                btn.classList.add('disabled');

                if (btn.tagName === 'BUTTON' || btn.tagName === 'INPUT') {
                    btn.disabled = true;
                } else {
                    btn.style.pointerEvents = 'none';
                }
            });

            window.addEventListener('pageshow', function () {
                unlockAll();
            });

        });
    </script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {

            function lockForm(form) {
                const btn = form.querySelector('button[type="submit"]');

                if (btn) {
                    btn.disabled = true;
                    btn.classList.add('disabled');
                }
                form.dataset.locked = "1";
            }

            function unlockAllForms() {
                document.querySelectorAll('form').forEach(form => {

                    form.dataset.locked = "0";

                    const btn = form.querySelector('button[type="submit"]');
                    if (btn) {
                        btn.disabled = false;
                        btn.classList.remove('disabled');
                    }
                });
            }

            document.addEventListener('submit', function (e) {

                const form = e.target;

                if (!form) return;

                if (form.id === 'aiForm' || form.id === 'registerUserSessionForm' || form.id === 'createChannelForm') {
                    return;
                }

                if (form.dataset.locked === "1") {
                    e.preventDefault();
                    return false;
                }

                lockForm(form);

            }, true);
            window.addEventListener('pageshow', function () {
                unlockAllForms();
            });
        });
    </script>

</body>
